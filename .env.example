# Copy to .env and configure values for this host. Never commit .env.

# ── Required secrets ─────────────────────────────────
# * Required. Shared secret for the private HTTP channel between the Web service and the realtime service; both services must use the same value. At least 32 characters is fine; a 64-character hexadecimal random string is recommended.
# Generation command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKSLASH_INTERNAL_SERVICE_KEY=
# * Required. Used to sign login session JWTs and to derive the key for encrypting saved AI API keys. At least 32 characters is fine; changing it will invalidate existing login sessions and encrypted AI API keys.
SESSION_SECRET=

# ── Deployment protocol and Web service ────────────────────────────
# Allowed values: http or https. When using https you must configure Caddy, the certificate chain file, and the private key file.
BACKSLASH_PROTOCOL=http
# The public hostname or IP address used to generate HTTPS configuration and links.
BACKSLASH_HOST=localhost
# HTTPS listen port, used only when BACKSLASH_PROTOCOL=https; commonly 443.
HTTPS_PORT=443
# Path or command name of the Caddy executable; leave empty to look up caddy from PATH.
CADDY_PATH=
# Optional path to a Caddy JSON configuration file; leave empty to generate automatically.
CADDY_CONFIG=
# Caddy configuration adapter; use json to indicate the configuration file is in JSON format.
CADDY_ADAPTER=json
# HTTPS certificate chain file; required when HTTPS is enabled.
CERTIFICATE_FILE=
# HTTPS private key file; required when HTTPS is enabled.
PRIVATE_KEY_FILE=
# Host address used by Caddy to forward to the Web service in HTTPS mode.
WEB_UPSTREAM_HOST=127.0.0.1
# Port used by Caddy to forward to the Web service in HTTPS mode.
WEB_UPSTREAM_PORT=3000
# Host address used by Caddy to forward to the WebSocket service in HTTPS mode.
WS_UPSTREAM_HOST=127.0.0.1
# Port used by Caddy to forward to the WebSocket service in HTTPS mode.
WS_UPSTREAM_PORT=3001

# ── Web and realtime services ─────────────────────────────────
# HTTP port used by browsers to access the Web service.
WEB_PORT=3000
# Port used by browsers to access the WebSocket service.
WS_PORT=3001
# WebSocket listen address; 0.0.0.0 means listen on all network interfaces.
WS_HOST=0.0.0.0
# Private Web port used by the authorization channel between the Web service and the realtime service; should only allow local access.
WEB_INTERNAL_PORT=3010
# Private realtime service port used by the authorization channel between the Web service and the realtime service; should only allow local access.
WS_INTERNAL_PORT=3011
# Maximum request body size allowed on the private realtime event channel, in bytes; range: 65536-16777216.
WS_INTERNAL_MAX_BODY_BYTES=4194304
# Interval for re-checking project permissions of connected realtime clients, in milliseconds.
WS_ACCESS_REVALIDATE_INTERVAL_MS=60000
# * Required. The full URL that browsers use to access this instance; must include http:// or https://, and non-standard ports must also be specified; must be configured in production.
APP_URL=http://localhost:3000
# Allowed browser origins for the WebSocket service; multiple origins separated by commas. When using * you must also set the confirmation item below.
CORS_ORIGIN=http://localhost:3000
# Must be set to true when CORS_ORIGIN=*; this allows requests from any browser origin.
CORS_ALLOW_ANY_ORIGIN_ACKNOWLEDGE_RISK=false
# Set to true to send cookies only over HTTPS; enabled by default in production unless explicitly set to false.
SECURE_COOKIES=false
# Set to true to disable new account registration.
DISABLE_SIGNUP=false
# Set to true only when a trusted reverse proxy will overwrite X-Forwarded-Host and X-Forwarded-Proto.
TRUST_PROXY_HEADERS=false
# Set to true to make the health-check endpoint return diagnostic details.
HEALTH_DETAILS_ENABLED=false
# Optional URL path prefix for the WebSocket Socket.IO endpoint.
# WS_PATH_PREFIX=
# Optional full WebSocket browser access URL; leave empty to derive from the current page or APP_URL.
# NEXT_PUBLIC_WS_URL=
# Set to false to disable realtime editing updates in the browser.
NEXT_PUBLIC_WS_ENABLED=true

# ── Authentication ────────────────────────────────────────
# Login session lifetime in days; range: 1-365.
SESSION_EXPIRY_DAYS=7
# Maximum number of active login sessions retained per user; range: 1-100.
MAX_SESSIONS_PER_USER=10
# Password hashing cost; range: 10-15. Higher values use more CPU during login and registration.
BCRYPT_ROUNDS=12

# ── Storage and SQLite ───────────────────────────────────
# Directory for the SQLite database, projects, compile working directories, and generated files.
STORAGE_PATH=./data
# Optional database file path; defaults to $STORAGE_PATH/backslash.db.
# SQLITE_PATH=./data/backslash.db
# Directory containing project templates.
TEMPLATES_PATH=./templates
# Wait time when SQLite encounters a database lock, in milliseconds. WAL mode is enabled automatically.
SQLITE_BUSY_TIMEOUT_MS=5000
# Number of WAL pages written before SQLite attempts an automatic checkpoint.
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000

# ── Local TeX Live ───────────────────────────────────
# Optional TeX Live bin directory; leave empty when latexmk is already on PATH.
TEXLIVE_BIN=
# Optional full path to latexmk; leave empty to derive from TEXLIVE_BIN or look up from PATH.
LATEXMK_PATH=
# Allowed values: pdflatex, xelatex, latex.
DEFAULT_LATEX_ENGINE=xelatex
# Maximum time for a single LaTeX compilation, in milliseconds.
COMPILE_TIMEOUT_MS=120000
# Maximum number of concurrent compilation tasks.
MAX_CONCURRENT_COMPILATIONS=2
# Maximum number of tasks allowed to wait in the compilation queue.
MAX_QUEUED_COMPILATIONS=200
# Maximum number of concurrent cleanup tasks.
MAX_CONCURRENT_CLEAN_TASKS=2
# Maximum size of compilation logs retained in memory, in bytes.
COMPILE_LOG_MAX_BYTES=10485760
# Maximum size of compilation logs persisted to SQLite, in bytes.
BUILD_LOG_DB_MAX_BYTES=1048576
# Number of completed tasks retained in memory.
COMPILE_TASK_HISTORY_LIMIT=200
# Retention time for completed task history, in minutes.
COMPILE_TASK_HISTORY_TTL_MINUTES=60
# Retention time for asynchronous compilation results, in minutes.
ASYNC_COMPILE_RESULT_TTL_MINUTES=60
# Maximum source archive size allowed for asynchronous compilation requests, in bytes.
ASYNC_COMPILE_SOURCE_MAX_BYTES=5242880
# Extra request body size reserved for multipart/base64 encoding overhead, in bytes.
ASYNC_COMPILE_REQUEST_OVERHEAD_BYTES=1048576
# Maximum size of base64-encoded PDFs returned by asynchronous compilation, in bytes.
ASYNC_COMPILE_BASE64_PDF_MAX_BYTES=10485760
# Maximum number of concurrent file upload tasks.
MAX_CONCURRENT_UPLOADS=2
# Maximum number of files allowed in a single upload request.
MAX_UPLOAD_FILE_COUNT=100
# Maximum total size of files allowed in a single upload request, in bytes.
MAX_UPLOAD_BATCH_BYTES=104857600
# Maximum size allowed for text files, in bytes.
MAX_TEXT_CONTENT_BYTES=5242880
# Maximum number of projects a user is allowed to create.
MAX_PROJECTS_PER_USER=100
# Interval for cleaning up expired asynchronous compilation results, in minutes.
ASYNC_COMPILE_CLEANUP_INTERVAL_MINUTES=15
# Retention period for completed build records, in days.
BUILD_RETENTION_DAYS=30
# Maximum number of completed builds retained per project.
BUILD_RETENTION_MAX_PER_PROJECT=50
# Interval for cleaning up build records, in minutes.
BUILD_CLEANUP_INTERVAL_MINUTES=60
# Time after which a build task with no updates is considered abandoned, in minutes.
STALE_BUILD_TTL_MINUTES=60
# Set to false to let LaTeX continue after an error occurs.
LATEX_HALT_ON_ERROR=true
# Set to true only for trusted LaTeX input; this allows executing host-accessible commands via \write18.
LATEX_ALLOW_SHELL_ESCAPE=false
# Must be set to true when LATEX_ALLOW_SHELL_ESCAPE=true.
LATEX_SHELL_ESCAPE_ACKNOWLEDGE_RISK=false
# Upper limit on total project source size, in MB.
LATEX_MAX_PROJECT_SIZE_MB=200
# Upper limit on generated output file size, in MB.
LATEX_MAX_OUTPUT_SIZE_MB=200
# Set to true to retain the working directory of failed compilations for debugging.
LATEX_KEEP_FAILED_WORKDIR=false
# Optional temporary directory and output directory; default under STORAGE_PATH.
# LATEX_TEMP_ROOT=./data/compile-temp
# LATEX_OUTPUT_ROOT=./data/compile-output

# ── Dashboard ───────────────────────────────────────
# Dashboard refresh interval, in milliseconds.
NEXT_PUBLIC_DASHBOARD_REFRESH_INTERVAL_MS=60000

# ── SMTP (optional; when not configured, reset links are written to the log) ───────
# Configure SMTP_HOST and SMTP_PORT to enable email sending; username and password are not required for unauthenticated SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# Set to true when using implicit TLS, typically with port 465; STARTTLS usually uses false and port 587.
# SMTP_SECURE=false
# Optional SMTP login username and password.
# SMTP_USER=
# SMTP_PASS=
# Sender address shown in outgoing emails.
# SMTP_FROM="Backslash <no-reply@example.com>"

# ── AI fallback configuration (optional) ────────────────────────
# API keys are all optional; configure the corresponding key for the provider selected in the application settings.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_API_KEY=
# Set to true only when explicitly using AI endpoints on a private network or LAN.
AI_ALLOW_PRIVATE_ENDPOINTS=false
# Optional provider API base URLs; leave commented to use each provider’s default address.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# CUSTOM_AI_BASE_URL=https://your-ai-service.example/v1
# Optional default model names used for build-fix and LaTeX writing tasks.
# AI_BUILD_FIX_MODEL=gpt-4o-mini
# AI_LATEX_WRITER_MODEL=gpt-4o-mini
# Provider-specific model names used when the corresponding provider is selected.
# AI_BUILD_FIX_MODEL_OPENROUTER=openai/gpt-4o-mini
# AI_LATEX_WRITER_MODEL_OPENROUTER=openai/gpt-4o-mini
# AI_BUILD_FIX_MODEL_ANTHROPIC=claude-3-5-sonnet-latest
# AI_LATEX_WRITER_MODEL_ANTHROPIC=claude-3-5-sonnet-latest