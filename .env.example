# Copy to .env and configure values for this host. Never commit .env.

# ── Required secrets ─────────────────────────────────
# Generate each value independently (64 hex chars):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKSLASH_INTERNAL_SERVICE_KEY=
SESSION_SECRET=

# ── Web and realtime services ────────────────────────
WEB_PORT=3000
WS_PORT=3001
WS_HOST=0.0.0.0
WEB_INTERNAL_PORT=3010
WS_INTERNAL_PORT=3011
# Set both values to the browser-visible origin, for example http://192.168.1.20:3000.
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
DISABLE_SIGNUP=false
# Trust X-Forwarded-* only behind a reverse proxy that overwrites those headers.
TRUST_PROXY_HEADERS=false
HEALTH_DETAILS_ENABLED=false
# WS_PATH_PREFIX=
# NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_WS_ENABLED=true

# ── Authentication ───────────────────────────────────
SESSION_EXPIRY_DAYS=7
MAX_SESSIONS_PER_USER=10
BCRYPT_ROUNDS=12

# ── Storage and SQLite ───────────────────────────────
STORAGE_PATH=./data
# SQLITE_PATH=./data/backslash.db
TEMPLATES_PATH=./templates
# Native node:sqlite settings. WAL is enabled automatically.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000

# ── Native TeX Live ──────────────────────────────────
# Leave empty when latexmk is available on PATH.
TEXLIVE_BIN=
LATEXMK_PATH=
DEFAULT_LATEX_ENGINE=xelatex
COMPILE_TIMEOUT_MS=120000
MAX_CONCURRENT_COMPILATIONS=2
MAX_QUEUED_COMPILATIONS=200
MAX_CONCURRENT_CLEAN_TASKS=2
COMPILE_LOG_MAX_BYTES=10485760
BUILD_LOG_DB_MAX_BYTES=1048576
COMPILE_TASK_HISTORY_LIMIT=200
COMPILE_TASK_HISTORY_TTL_MINUTES=60
ASYNC_COMPILE_RESULT_TTL_MINUTES=60
ASYNC_COMPILE_SOURCE_MAX_BYTES=5242880
ASYNC_COMPILE_REQUEST_OVERHEAD_BYTES=1048576
ASYNC_COMPILE_BASE64_PDF_MAX_BYTES=10485760
MAX_CONCURRENT_UPLOADS=2
MAX_TEXT_CONTENT_BYTES=5242880
MAX_PROJECTS_PER_USER=100
ASYNC_COMPILE_CLEANUP_INTERVAL_MINUTES=15
BUILD_RETENTION_DAYS=30
BUILD_RETENTION_MAX_PER_PROJECT=50
BUILD_CLEANUP_INTERVAL_MINUTES=60
STALE_BUILD_TTL_MINUTES=60
LATEX_HALT_ON_ERROR=true
LATEX_ALLOW_SHELL_ESCAPE=false
LATEX_MAX_PROJECT_SIZE_MB=200
LATEX_MAX_OUTPUT_SIZE_MB=200
LATEX_KEEP_FAILED_WORKDIR=false
# LATEX_TEMP_ROOT=./data/compile-temp
# LATEX_OUTPUT_ROOT=./data/compile-output

# ── Dashboard ────────────────────────────────────────
NEXT_PUBLIC_DASHBOARD_REFRESH_INTERVAL_MS=60000

# ── SMTP (optional; reset URLs are logged when unset) ─
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Backslash <no-reply@example.com>"

# ── AI fallback settings (optional) ──────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_API_KEY=
# Private/LAN endpoints are blocked by default to reduce SSRF risk.
AI_ALLOW_PRIVATE_ENDPOINTS=false
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# CUSTOM_AI_BASE_URL=https://your-ai-service.example/v1
# AI_BUILD_FIX_MODEL=gpt-4o-mini
# AI_LATEX_WRITER_MODEL=gpt-4o-mini
# AI_BUILD_FIX_MODEL_OPENROUTER=openai/gpt-4o-mini
# AI_LATEX_WRITER_MODEL_OPENROUTER=openai/gpt-4o-mini
# AI_BUILD_FIX_MODEL_ANTHROPIC=claude-3-5-sonnet-latest
# AI_LATEX_WRITER_MODEL_ANTHROPIC=claude-3-5-sonnet-latest
