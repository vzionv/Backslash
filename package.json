{
  "name": "backslash",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm --filter @backslash/web build && pnpm --filter @backslash/ws build",
    "validate": "bash scripts/validate.sh",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm validate"
  },
  "devDependencies": {
    "drizzle-orm": "0.45.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
